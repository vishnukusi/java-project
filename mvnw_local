#!/usr/bin/env bash
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export JAVA_HOME="${PROJECT_ROOT}/.tools/amazon-corretto-21.jdk/Contents/Home"
export PATH="${JAVA_HOME}/bin:${PROJECT_ROOT}/.tools/apache-maven-3.9.6/bin:${PATH}"

ARGS=()
for arg in "$@"; do
    if [ "$arg" = "clean" ]; then
        rm -rf "${PROJECT_ROOT}/target"
    else
        ARGS+=("$arg")
    fi
done

if [ ${#ARGS[@]} -eq 0 ]; then
    echo "[INFO] Cleaned target directory."
    exit 0
fi

exec "${PROJECT_ROOT}/.tools/apache-maven-3.9.6/bin/mvn" "${ARGS[@]}"
