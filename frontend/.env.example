# Base URL of the SentinelCV Spring Boot backend (used only when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:8080

# true  = use bundled mock fixtures (default; nothing is sent to a backend)
# false = call the backend through src/services/*.js (contracts are PROPOSED, see API_INTEGRATION.md)
VITE_USE_MOCK=true
